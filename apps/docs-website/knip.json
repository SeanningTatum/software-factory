{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/__root.tsx",
    "src/gen/*.ts",
    "src/app/**/*.{ts,tsx}",
    "src/features/{consent,home}/**/*.{ts,tsx}",
    "src/features/core/{analytics,observability,ui}/**/*.{ts,tsx}",
    "src/features/{*,core/*}/routes/**/*.{ts,tsx}",
    "src/features/{*,core/*}/{layer,errors,events,nav,viewer,auth-plugins,workflows,schema}.ts",
    "src/features/*/e2e/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "tailwindcss",
    "@fontsource-variable/schibsted-grotesk",
    "@fontsource/commit-mono"
  ]
}

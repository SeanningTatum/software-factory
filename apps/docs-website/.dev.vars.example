# Copy to .dev.vars for local development. Generated by `software-factory-blocks sync`.

# --- Analytics ---
# Where analytics events go: none, console, posthog or analytics-engine (optional).
ANALYTICS_PROVIDER=console
# PostHog ingest host (optional).
POSTHOG_HOST=https://us.i.posthog.com
# PostHog project API key, used when ANALYTICS_PROVIDER is posthog (optional). See https://posthog.com/docs/api
POSTHOG_KEY=

# --- Observability ---
# Lowest level written to the logs: Debug, Info, Warn or Error (optional).
LOG_LEVEL=Info
# Where errors go: none, console or sentry (optional).
ERROR_REPORTER=console
# Sentry DSN, used when ERROR_REPORTER is sentry (optional). See https://docs.sentry.io/concepts/key-terms/dsn-explainer/
SENTRY_DSN=
# Slack or Discord incoming webhook; the first error of a burst posts there, then it stays quiet for 5 minutes (optional). See https://api.slack.com/messaging/webhooks
ALERT_WEBHOOK_URL=

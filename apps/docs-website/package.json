{
  "name": "docs-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy --env staging",
    "generate": "wrangler types --strict-vars=false && tsr generate",
    "postinstall": "wrangler types --strict-vars=false && tsr generate",
    "typecheck": "tsc -p .",
    "lint": "biome check . && software-factory-lint && software-factory-blocks check",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "blocks:sync": "software-factory-blocks sync",
    "blocks:check": "software-factory-blocks check",
    "machines:print": "PRINT_MACHINES=1 vitest run src/app/machines.test.ts",
    "size": "bun size.ts",
    "knip": "knip",
    "check": "bun run lint && bun run typecheck && bun run test && bun run knip",
    "setup": "create-software-factory setup"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.1.5",
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.19.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "web-vitals": "^6.2.3",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@seanningtatum/software-factory-biome-config": "workspace:*",
    "@seanningtatum/software-factory-blocks": "workspace:*",
    "@seanningtatum/software-factory-lint": "workspace:*",
    "@seanningtatum/software-factory-tsconfig": "workspace:*",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@seanningtatum/create-software-factory": "workspace:*",
    "knip": "^6.48.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "imports": {
    "#/*": "./src/*"
  }
}

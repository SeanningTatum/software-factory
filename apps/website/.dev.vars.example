# Copy to .dev.vars for local development. Generated by `cf-saas-blocks sync`.

# --- Analytics ---
# Where analytics events go: none, console, posthog or analytics-engine (optional).
ANALYTICS_PROVIDER=console
# PostHog ingest host (optional).
POSTHOG_HOST=https://us.i.posthog.com
# PostHog project API key, used when ANALYTICS_PROVIDER is posthog (optional). See https://posthog.com/docs/api
POSTHOG_KEY=

# --- Observability ---
# Lowest level written to the logs: Debug, Info, Warn or Error (optional).
LOG_LEVEL=Info
# Where errors go: none, console or sentry (optional).
ERROR_REPORTER=console
# Sentry DSN, used when ERROR_REPORTER is sentry (optional). See https://docs.sentry.io/concepts/key-terms/dsn-explainer/
SENTRY_DSN=
# Slack or Discord incoming webhook; the first error of a burst posts there, then it stays quiet for 5 minutes (optional). See https://api.slack.com/messaging/webhooks
ALERT_WEBHOOK_URL=

# --- Auth ---
# Public origin of the app, e.g. https://app.example.com (required).
APP_URL=http://localhost:3001
# Extra origins allowed to call the auth API, comma-separated (optional).
TRUSTED_ORIGINS=
# Turnstile site key (public). With TURNSTILE_SECRET_KEY, sign-up needs a Turnstile token; the example is Cloudflare's always-pass test key (optional). See https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Signs sessions; at least 32 random characters (required).
BETTER_AUTH_SECRET=
# Turnstile secret key; the example is Cloudflare's always-pass test secret, never use it in production (optional).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Billing ---
# Stripe price id for the Pro plan (price_...) (required). See https://dashboard.stripe.com/products
STRIPE_PRICE_PRO=
# Stripe secret key (sk_test_... or sk_live_...) (required). See https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook pointing at /api/auth/stripe/webhook (required). See https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

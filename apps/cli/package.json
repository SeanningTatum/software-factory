{
  "name": "create-software-factory",
  "version": "0.3.0",
  "description": "A software factory for Cloudflare Workers: compose a TanStack Start SaaS from blocks (database, auth, billing, KV, Workflows, uploads).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-software-factory": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "harness",
    "husky"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "bundle": "bun scripts/bundle-template.ts",
    "build": "bun run bundle && bun build src/index.ts --outdir dist --target node --external jsonc-parser",
    "typecheck": "tsc -p .",
    "test": "bun test ./src",
    "test:matrix": "bun scripts/block-matrix.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@seanningtatum/software-factory-blocks": "workspace:*",
    "@seanningtatum/software-factory-tsconfig": "workspace:*",
    "@types/bun": "latest",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "xstate": "5.33.4",
    "@seanningtatum/software-factory-lint": "workspace:*"
  }
}

{
  "name": "production",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/production"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "check"
          },
          {
            "context": "secrets"
          },
          {
            "context": "e2e"
          },
          {
            "context": "staging"
          }
        ]
      }
    }
  ]
}

{
  "name": "@tanstack-cf-saas/saas-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy --env staging",
    "generate": "wrangler types --strict-vars=false && tsr generate",
    "postinstall": "wrangler types --strict-vars=false && tsr generate",
    "typecheck": "tsc -p .",
    "lint": "biome check . && cf-saas-lint && cf-saas-blocks check",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "blocks:sync": "cf-saas-blocks sync",
    "blocks:check": "cf-saas-blocks check",
    "machines:print": "PRINT_MACHINES=1 vitest run src/app/machines.test.ts",
    "size": "bun size.ts",
    "knip": "knip",
    "check": "bun run lint && bun run typecheck && bun run test && bun run knip",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.7.27",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@xstate/react": "6.1.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "web-vitals": "^6.2.3",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack-cf-saas/biome-config": "workspace:*",
    "@tanstack-cf-saas/blocks": "workspace:*",
    "@tanstack-cf-saas/lint": "workspace:*",
    "@tanstack-cf-saas/tsconfig": "workspace:*",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.48.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "imports": {
    "#/*": "./src/*"
  }
}

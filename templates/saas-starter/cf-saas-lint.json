{
  "allow": {
    "no-throw": [
      "src/features/auth/api/guard.ts",
      "src/app/run-effect.ts",
      "src/routes/__root.tsx"
    ],
    "no-run-effect": [
      "src/app/run-effect.ts",
      "src/app/middleware.ts",
      "src/features/*/workflows.ts"
    ],
    "no-try-catch": [],
    "no-process-env": ["src/features/*/e2e/**", "src/app/machines.test.ts"]
  },
  "testExempt": [
    "src/**/*.tsx",
    "src/**/auth-plugins.ts",
    "src/**/errors.ts",
    "src/**/events.ts",
    "src/**/layer.ts",
    "src/**/nav.ts",
    "src/**/schema.ts",
    "src/**/viewer.ts",
    "src/features/*/routes/**",
    "src/features/*/lib/*-client.ts",
    "src/features/*/api/guard.ts",
    "src/features/*/api/memory-*.ts",
    "src/features/*/api/test-*.ts",
    "src/features/*/workflows.ts",
    "src/features/observability/lib/log-sink.ts",
    "src/app/shell.ts",
    "src/app/testing/**"
  ]
}

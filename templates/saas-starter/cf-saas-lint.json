    "src/blocks/*/memory-*.ts",
    "src/blocks/*/test-*.ts",
    "src/blocks/*/workflows.ts",
    "src/core/block.json",
    "src/core/log-sink.ts",
    "src/core/shell.ts",
    "src/test/**"

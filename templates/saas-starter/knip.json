{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/__root.tsx",
    "src/gen/*.ts",
    "src/app/**/*.{ts,tsx}",
    "src/features/{analytics,consent,home,observability,ui}/**/*.{ts,tsx}",
    "src/features/*/routes/**/*.{ts,tsx}",
    "src/features/*/{layer,errors,events,nav,viewer,auth-plugins,workflows,schema}.ts",
    "src/features/*/e2e/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["tailwindcss"]
}

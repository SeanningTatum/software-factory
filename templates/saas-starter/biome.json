{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["@tanstack-cf-saas/biome-config"],
  "files": {
    "includes": [
      "**",
      "!src/gen",
      "!FEATURES.md",
      "!src/features/*/TIMELINE.md",
      "!src/routeTree.gen.ts",
      "!worker-configuration.d.ts",
      "!drizzle",
      "!.wrangler",
      "!dist",
      "!wrangler.jsonc",
      "!cf-saas.json",
      "!harness.lock.json",
      "!.tanstack"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/features/observability/lib/log-sink.ts",
        "src/features/observability/api/error-reporter.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/server.ts", "src/features/analytics/api/adapters/**"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off",
            "noBarrelFile": "off"
          },
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/ui/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}

{
  "name": "tanstack-cf-saas-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && turbo run lint",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run lint && sh scripts/promote.test.sh && turbo run typecheck test build",
    "try": "bun apps/cli/scripts/try.ts",
    "teardown": "bun apps/cli/scripts/teardown.ts",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* --filter=create-tanstack-cf-saas && changeset publish",
    "promote": "sh scripts/promote.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "@tanstack-cf-saas/biome-config": "workspace:*",
    "husky": "^9.1.7",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}

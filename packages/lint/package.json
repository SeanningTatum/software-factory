{
  "name": "@seanningtatum/software-factory-lint",
  "version": "0.4.0",
  "description": "House lint rules for software-factory projects: Effect rules, the test map and the state machine gate",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./machines": {
      "types": "./src/machines.ts",
      "default": "./dist/machines.js"
    }
  },
  "bin": {
    "software-factory-lint": "./dist/bin.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/machines.ts src/bin.ts --outdir dist --target node --packages external",
    "typecheck": "tsc -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@seanningtatum/software-factory-tsconfig": "workspace:*",
    "@types/bun": "latest",
    "xstate": "5.33.4"
  },
  "peerDependencies": {
    "xstate": "^5.0.0"
  }
}

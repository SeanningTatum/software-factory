{
  "name": "@seanningtatum/software-factory-blocks",
  "version": "0.3.0",
  "description": "Feature manifests and the generators that wire features into a software-factory project",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "software-factory-blocks": "./dist/bin.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/bin.ts --outdir dist --target node --packages external",
    "typecheck": "tsc -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@seanningtatum/software-factory-lint": "^0.4.0",
    "effect": "^4.1.5",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@seanningtatum/software-factory-tsconfig": "workspace:*",
    "@types/bun": "latest"
  }
}

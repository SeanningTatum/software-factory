{
  "name": "@tanstack-cf-saas/blocks",
  "version": "0.1.0",
  "description": "Feature manifests and the generators that wire features into a tanstack-cf-saas project",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./src/define.ts",
      "default": "./dist/define.js"
    }
  },
  "bin": {
    "cf-saas-blocks": "./dist/bin.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/define.ts src/bin.ts --outdir dist --target node --packages external",
    "typecheck": "tsc -p .",
    "test": "bun test"
  },
  "dependencies": {
    "effect": "^4.1.5",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@tanstack-cf-saas/tsconfig": "workspace:*",
    "@types/bun": "latest"
  }
}

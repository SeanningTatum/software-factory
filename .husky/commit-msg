# The subject, the first line that is not blank or a comment, must be a conventional commit:
# type(scope)!: subject. Lines git writes itself (merge, revert, fixup, squash) pass.
subject=$(sed -n -e '/^#/d' -e '/[^[:space:]]/{p;q;}' "$1")
printf '%s\n' "$subject" | grep -qE '^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9,/-]+\)!?: .+|Merge .+|Revert ".+|(fixup|squash)! .+)' && exit 0

echo "commit-msg: \"$subject\" is not a conventional commit." >&2
echo "Write it as type(scope): subject, for example: feat(auth): lock an account after five bad passwords" >&2
echo "Types: feat fix docs style refactor perf test build ci chore revert. The scope is required: the feature or part the change touches." >&2
exit 1

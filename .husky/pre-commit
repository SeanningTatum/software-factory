# A commit adds at most MAX lines, so a reader can take it in at one sitting.
# Generated files and lockfiles do not count. A merge, a revert and a cherry-pick replay work
# that is already written, so they are not checked.
# shortcut: an amend is measured on its new lines alone, so amends can grow a commit past the limit; measure against HEAD~1 if that gets abused.
MAX=400

for head in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
  if git rev-parse -q --verify "$head" >/dev/null; then exit 0; fi
done

added=$(git diff --cached --numstat -- . \
  ':(exclude)bun.lock' ':(exclude)pnpm-lock.yaml' ':(exclude)package-lock.json' ':(exclude)yarn.lock' \
  ':(exclude,glob)**/src/gen/**' \
  ':(exclude,glob)**/drizzle/**' |
  awk '{ n += $1 } END { print n + 0 }')

[ "$added" -le "$MAX" ] && exit 0

echo "pre-commit: this commit adds $added lines; the limit is $MAX." >&2
echo "Split it: stage one step at a time (git add -p, or file by file) and commit each on its own." >&2
exit 1
